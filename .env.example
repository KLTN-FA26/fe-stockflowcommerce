# ──────────────────────────────────────────────────────────────
# StockFlowCommerce — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this to .env.local and adjust values.

# API base URL (production backend)
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Use mock adapter instead of real API (true = mock, false/unset = real)
NEXT_PUBLIC_USE_MOCK=true

# JWT (Spring Boot backend handles auth — FE only stores tokens)
# No server-side auth secret needed on the FE side.
